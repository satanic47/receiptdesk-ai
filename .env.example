# ReceiptDesk AI - Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Open AI Model - Google Gemma Configuration
# Supports local Ollama (e.g. gemma2:2b / gemma2:9b), HuggingFace local open weights, or open inference endpoints
GEMMA_MODEL_NAME=gemma-2-2b-it
GEMMA_INFERENCE_MODE=local_fallback # Options: local_fallback, ollama, huggingface
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Tiger Data pgvector Database (PostgreSQL with vector extension)
# When set, enables hybrid semantic similarity search across historical invoices
# Instance example: sudhir-83938
TIGER_DATA_PG_URL=postgresql://user:password@instance-region.tigerdata.cloud:5432/receiptdesk

# Storage Mode
# 'sqlite' for 100% offline local privacy mode, 'tiger' for Tiger Data pgvector cloud
STORAGE_BACKEND=sqlite
LOCAL_DB_PATH=./data/receiptdesk.db
